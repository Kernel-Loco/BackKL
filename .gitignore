.env
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# En la raíz solo se versiona README.md (igual que FrontKL)
/*.md
!/README.md

# Marca de inicio de cada grabación (local)
cirdan/recolectores/respuestas_grabadas/*/*/.grabacion

# Grabaciones reales de crt.sh y Cert Spotter (local). La imagen de la API sí las copia (README.md)
cirdan/recolectores/respuestas_grabadas/crtsh/*
!cirdan/recolectores/respuestas_grabadas/crtsh/.gitkeep

# Carpeta de grabaciones de antes del 11 oct: su contenido se mueve a cirdan/recolectores/respuestas_grabadas/
/respuestas_grabadas/
