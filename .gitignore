.env
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# En la raíz solo se versiona README.md (igual que FrontKL)
/*.md
!/README.md

# Marca de inicio de cada grabación (local)
cirdan/recolectores/respuestas_grabadas/*/*/.grabacion

# Grabaciones reales de crt.sh y Cert Spotter (local). La imagen de la API sí las copia (README.md)
cirdan/recolectores/respuestas_grabadas/crtsh/*
!cirdan/recolectores/respuestas_grabadas/crtsh/.gitkeep

# Grabaciones reales de subfinder (local), igual que las de crt.sh
cirdan/recolectores/respuestas_grabadas/subfinder/*
!cirdan/recolectores/respuestas_grabadas/subfinder/.gitkeep
# Grabaciones reales del DNS (local, #15). Ya van sin tokens, pero muestran la zona de la empresa
cirdan/recolectores/respuestas_grabadas/dns/*
!cirdan/recolectores/respuestas_grabadas/dns/.gitkeep
# GitHub (#16, RC-50): solo lo ya limpio (perfil, lista de repos, secretos reducidos y correos del dominio)
cirdan/recolectores/respuestas_grabadas/github/*
!cirdan/recolectores/respuestas_grabadas/github/.gitkeep
# Shodan InternetDB (#17, RC-49): solo lo ya limpio (páginas de Cert Spotter reducidas, cada A y cada IP de InternetDB)
cirdan/recolectores/respuestas_grabadas/shodan/*
!cirdan/recolectores/respuestas_grabadas/shodan/.gitkeep
# RDAP (#15b, RC-166): solo lo ya limpio (bootstrap reducido y respuesta RDAP filtrada, sin contactos)
cirdan/recolectores/respuestas_grabadas/whois/*
!cirdan/recolectores/respuestas_grabadas/whois/.gitkeep

# Bases de DB-IP Lite (#15b, RC-166): pesan unos 17 MB y se bajan a mano cada mes. La imagen de la API sí las copia (Dockerfile)
datos/geo/*
!datos/geo/.gitkeep

# Carpeta de grabaciones de antes del 11 oct: su contenido se mueve a cirdan/recolectores/respuestas_grabadas/
/respuestas_grabadas/
