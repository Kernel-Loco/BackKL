# Copia este archivo como .env (nunca se sube al repositorio) y cambia las contraseñas.
# docker compose lo lee solo; fuera de Docker, la API lo lee desde la raíz del repo.

# PostgreSQL 16 (contenedor cirdan-pg16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=cirdan
# Contraseña del rol de la aplicación (sin superusuario ni BYPASSRLS)
CIRDAN_APP_PASSWORD=cambia_esta_clave

# Valkey (sesiones). Solo escucha en 127.0.0.1.
VALKEY_PORT=6379
VALKEY_PASSWORD=cambia_esta_clave

# Llave para cifrar los secretos de MFA (TOTP) en la base: 32 bytes en base64 url-safe.
# Genera la tuya con:  python3 -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOTP_ENCRYPTION_KEY=genera_tu_llave

# Cuentas de demostración (contraseña y MFA de los usuarios de la semilla). Solo en desarrollo.
DEMO_ACCOUNTS=true

# Explorador de la base en /demo y /db (RC-58). Pide sesión de Admin y muestra solo la empresa de esa sesión.
# true solo para la demo. Con false esas rutas no existen. Nunca true en producción.
DEMO_EXPLORER=false

# true cuando la API se sirva con HTTPS (producción): la cookie de sesión solo viaja cifrada.
COOKIE_SECURE=false

# De quién acepta la API X-Forwarded-For, que da la IP del bloqueo por intentos del login. Sin poner,
# de nadie de fuera del contenedor. En el despliegue (#49): la IP o el CIDR con que la API ve llegar
# al portal, detrás de un proxy que agregue la IP real. Revísala si se recrea la red de Docker. "*" solo para
# una prueba local (ver docker-compose.yml).
# FORWARDED_ALLOW_IPS=

# Dominios que el orquestador puede consultar en vivo, separados por comas. Los dominios de la
# demo (acme-demo.mx, etc.) no son del equipo y nunca se consultan en vivo. En producción: *
DOMINIOS_EN_VIVO=olmardo.com
