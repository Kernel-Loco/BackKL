# Copia este archivo como .env (nunca se sube al repositorio) y cambia las contraseñas.
# docker compose lo lee solo; fuera de Docker, la API lo lee desde la raíz del repo.

# PostgreSQL 16 (contenedor cirdan-pg16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=cirdan
PGDATABASE=cirdan
# Contraseña del rol de la aplicación (sin superusuario ni BYPASSRLS)
CIRDAN_APP_PASSWORD=cambia_esta_clave
# Contraseña independiente del cargador de inteligencia (RC-127), solo si se habilita su profile.
CIRDAN_INTEL_PASSWORD=

# Valkey (sesiones). Solo escucha en 127.0.0.1.
VALKEY_PORT=6379
# Contraseña de cirdan_api, el usuario de la API, que solo corre sus comandos y sus llaves (RC-292).
VALKEY_PASSWORD=cambia_esta_clave
# Contraseña de cirdan_admin, el usuario con todos los comandos, para operar y para las pruebas. Otra que la de
# arriba. Solo la recibe el contenedor de Valkey. Vacía, docker compose no levanta. Genera la tuya con:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
VALKEY_ADMIN_PASSWORD=

# Llave para cifrar los secretos de MFA (TOTP) en la base: 32 bytes en base64 url-safe.
# Genera la tuya con:  python3 -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOTP_ENCRYPTION_KEY=genera_tu_llave
# En la VM la llave no va aquí: se deja vacía TOTP_ENCRYPTION_KEY y se pone la URL de su secreto en Azure Key Vault,
# que la API lee con la identidad administrada (docs/despliegue.md). Nunca las dos.
# La variable es TOTP_KEY_VAULT_SECRET_URL, con la forma https://<bóveda>.vault.azure.net/secrets/<nombre>/<versión>
# (la versión es obligatoria).
# Rotar esa llave (RC-295, pasos en docs/despliegue.md): la nueva va arriba y la de antes en
# TOTP_PREVIOUS_ENCRYPTION_KEY (o la URL de su secreto en TOTP_PREVIOUS_KEY_VAULT_SECRET_URL, nunca las dos). Cada
# secreto que abre con la anterior queda con la nueva en el siguiente código bueno. Fuera de una rotación, vacía.
TOTP_PREVIOUS_ENCRYPTION_KEY=

# Llave para cifrar las huellas de contraseña (pepper, RC-330): otros 32 bytes en base64 url-safe, distintos de
# TOTP_ENCRYPTION_KEY. Se genera con el mismo comando. Sin ella la API no arranca. Si se pierde, ninguna contraseña
# guardada vuelve a abrir: guarda una copia en el gestor de contraseñas.
PASSWORD_HASH_ENCRYPTION_KEY=genera_tu_llave
# En la VM tampoco va aquí: se deja vacía y se pone PASSWORD_HASH_KEY_VAULT_SECRET_URL, con la URL de otro secreto
# de Key Vault con la misma forma que la del MFA. Nunca las dos.
# Rotar esa llave (RC-333, pasos en docs/despliegue.md): PASSWORD_HASH_KEY_VERSION sube en 1, la llave nueva va arriba
# y la de antes en PASSWORD_HASH_PREVIOUS_ENCRYPTION_KEY (o la URL de su secreto en
# PASSWORD_HASH_PREVIOUS_KEY_VAULT_SECRET_URL, nunca las dos). Fuera de una rotación la versión queda en 1 o en la
# última y la anterior vacía.
PASSWORD_HASH_KEY_VERSION=1
PASSWORD_HASH_PREVIOUS_ENCRYPTION_KEY=

# Contraseñas filtradas (RC-334): con true, cada contraseña nueva se revisa contra Pwned Passwords. Solo salen los 5
# primeros caracteres hex de su SHA-1 a https://api.pwnedpasswords.com/range/, sin cuenta ni costo
# (docs/servicios_externos.md). Si no responde en 2 s, se revisa solo con la lista local. Vacía queda en false en tu PC
# y en el CI (docker-compose.yml), para no consultar en vivo, y en true en la VM (docker-compose.despliegue.yml).
# Con un valor, ese valor manda en los dos.
PWNED_PASSWORDS_ENABLED=

# Alta de dominios. También en producción queda apagada hasta poner true, después de una restauración completa validada.
# En desarrollo, genera una llave diferente de las dos anteriores. No la cambies ni pierdas después de guardar cartas.
CARTA_ALTA_ENABLED=false
CARTA_ENCRYPTION_KEY=
# En vez de la llave local se puede configurar esta URL versionada de Key Vault (la de la VM). Nunca las dos.
CARTA_KEY_VAULT_SECRET_URL=
# Nombre físico del volumen de cartas. Vacío, sigue el nombre del proyecto de Compose.
CARTA_VOLUME_NAME=
# Fuera de Docker, CARTA_STORAGE_DIR debe apuntar a un directorio absoluto, privado y persistente.

# Firma de la carta con Mifiel desde el portal (RC-211). apagado (por omisión), sandbox o produccion. Apagado, el
# portal solo acepta la carta firmada en la web de Mifiel y nunca se llama a su API. Las llaves del sandbox y las de
# producción no se mezclan. Pide en el chat de Mifiel que activen la API de tu cuenta. Necesita CARTA_ALTA_ENABLED.
FIRMA_MODO=apagado
MIFIEL_APP_ID=
MIFIEL_APP_SECRET=

# Cuentas de demostración (contraseña y MFA públicos de los usuarios de la semilla). Viene en false para que
# copiar este archivo en un despliegue no las prenda. En tu PC, para desarrollar y correr las pruebas, cámbiala
# a true (docs/cuentas_de_prueba.md). Nunca true en un despliegue.
DEMO_ACCOUNTS=false

# Explorador de la base en /demo y /db (RC-58). Pide sesión de Admin y muestra solo la empresa de esa sesión.
# true solo para la demo. Con false esas rutas no existen. Nunca true en producción.
DEMO_EXPLORER=false

# Documentación de la API en /openapi.json, /docs y /redoc. Con false esas rutas no existen (RC-303). Ponla en true
# solo en tu PC para ver http://127.0.0.1:8000/docs. El despliegue la fija en false aunque aquí diga true
# (docker-compose.despliegue.yml, comentario 10063 de RC-91).
API_DOCS=false

# true cuando la API se sirva con HTTPS (producción): la cookie de sesión solo viaja cifrada. Con un origen https en
# ALLOWED_ORIGINS y sin true, la API no arranca (RC-286). En tu PC, con http://localhost, false.
COOKIE_SECURE=false
# Dominio de las passkeys (RC-331): localhost en tu PC. En la VM lo pone docker-compose.despliegue.yml (lowtidesec.com).
# WEBAUTHN_RP_ID=localhost

# De quién acepta la API X-Forwarded-For, que da la IP del bloqueo por intentos del login. Sin poner,
# de nadie de fuera del contenedor. En el despliegue (#49): la IP o el CIDR con que la API ve llegar
# al portal, detrás de un proxy que agregue la IP real. Revísala si se recrea la red de Docker. "*" solo para
# una prueba local (ver docker-compose.yml).
# FORWARDED_ALLOW_IPS=

# Dominios que el orquestador puede consultar en vivo, separados por comas. Los dominios de la
# demo (acme-demo.mx, etc.) no son del equipo y nunca se consultan en vivo. En producción: *
DOMINIOS_EN_VIVO=olmardo.com

# Organización de GitHub que cada empresa declaró controlar, con pares dominio=org separados por
# comas (#16, RC-50). El recolector de GitHub solo revisa los repos públicos de la declarada. Un
# dominio sin par, o con 'ninguna' (olmardo.com=ninguna), no consulta GitHub y queda sin cobertura.
ORGS_GITHUB_DECLARADAS=olmardo.com=olmardo

# Llave de la API de host de Shodan (RC-337). La cuenta es académica: solo uso no comercial. El recolector de
# Shodan solo la usa en GET /shodan/host/<ip>, nunca para escanear ni buscar. Vacía, exposed_iot_device,
# exposed_ot_device y outdated_software salen solo de las etiquetas de InternetDB (docs/servicios_externos.md).
SHODAN_API_KEY=

# Llave para cifrar las llaves de API de las fuentes en data_sources.api_key_enc (RC-54, hoy solo la de Have I Been
# Pwned): 32 bytes en base64 url-safe, distintos de TOTP_ENCRYPTION_KEY, con el mismo comando. La llave de HIBP se
# cifra con python -m cirdan.recolectores.llaves cifrar hibp (docs/servicios_externos.md). Vacía, o si se pierde, HIBP
# queda 'Sin cobertura de HIBP' por falta de llave y el escaneo sigue.
SOURCE_KEYS_ENCRYPTION_KEY=

# Asistente sobre hallazgos (#38). Workers AI es el proveedor principal; Groq es el respaldo.
# Se usan endpoints compatibles con OpenAI y los dos reciben solo la pregunta y título, categoría y severidad
# de los hallazgos seleccionados. No se guardan preguntas ni respuestas.
# IA_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# IA_RESPALDO_BASE_URL=https://api.groq.com/openai/v1
IA_BASE_URL=
IA_API_KEY=
IA_MODELO=@cf/openai/gpt-oss-120b
IA_RESPALDO_BASE_URL=
IA_RESPALDO_API_KEY=
IA_RESPALDO_MODELO=openai/gpt-oss-120b

# Enlace al correo para entrar (#28, RC-63), por la API HTTPS de Resend (docs/servicios_externos.md, fila Correo).
# La llave de envío (limitada a lowtidesec.com) la tiene Ernesto: nunca en git. Vacía, pedir el enlace responde igual,
# no se envía nada y queda un aviso en el log. En tu PC puede quedar vacía.
CORREO_API_KEY=
# Remitente del correo. Por omisión LowTide <acceso@lowtidesec.com>.
# CORREO_REMITENTE=
# Dirección del portal con la que se arma el enlace, sin barra final. Vacía, docker-compose.yml usa
# http://localhost:3000 en tu PC. En el despliegue docker-compose.despliegue.yml la deja vacía y el enlace usa el
# primer origen de ALLOWED_ORIGINS.
PORTAL_URL=
# Correos de enlace y de recuperación de contraseña (RC-335) que se envían al día (UTC), juntos, debajo de los 100
# de Resend Free. Por omisión 80.
# ENLACE_TOPE_DIARIO=80

# Llave del HMAC con que el recolector de identidad (#20, RC-56) saca la huella de un correo personal, de al menos 32
# caracteres. Se genera con python -c "import secrets; print(secrets.token_urlsafe(48))". Vacía o corta, no reporta
# personal_email_exposed (queda sin cobertura) y no graba. Si cambia, las huellas cambian: los hallazgos abiertos se
# cierran y los mismos correos salen otra vez como hallazgos nuevos.
IDENTITY_HMAC_KEY=

# Solo para el despliegue (#49, RC-91) con docker-compose.despliegue.yml (docs/despliegue.md). En tu PC no hacen falta.
# Orígenes del portal publicado, sin barra final: el dominio y su www. También apaga las cuentas de demo (RC-287).
# ALLOWED_ORIGINS=https://lowtidesec.com,https://www.lowtidesec.com
# En el plan B de pruebas (RC-277), solo su subdominio:
# ALLOWED_ORIGINS=https://pruebas.lowtidesec.com
# Que todo `docker compose` de la carpeta use los dos archivos, aunque se escriba sin -f. El separador, para Windows.
# COMPOSE_FILE=docker-compose.yml:docker-compose.despliegue.yml
# COMPOSE_PATH_SEPARATOR=:
# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels). Nunca en git.
# TUNNEL_TOKEN=
# Carpeta de FrontKL, si no está junto a BackKL.
# PORTAL_DIR=../FrontKL
# Solo en el plan B: el nombre del proyecto de Compose, para que su base no use el volumen de desarrollo de esa PC.
# COMPOSE_PROJECT_NAME=lowtide-planb
# En el plan B de pruebas (RC-277): COMPOSE_PROJECT_NAME=lowtide-pruebas
