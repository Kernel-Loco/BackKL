* text=auto
*.sh text eol=lf
# El lote del ML se compara byte a byte con lo que genera cirdan/ml/generar_lote.py: sin cambiar fines de línea
datos/ml/** -text
# La lista de contraseñas comunes (RC-281) se compara con el sha256 de cirdan/auth/datos/README.md: siempre LF
cirdan/auth/datos/contrasenas_comunes.txt text eol=lf
# El modelo se carga solo si su sha256 es el de modelo_v1.joblib.sha256 (RC-305): el artefacto sin tocar y la huella siempre LF
cirdan/ml/modelo_v1.joblib binary
cirdan/ml/modelo_v1.joblib.sha256 text eol=lf
# Fichas generadas byte a byte por modelo.py y anomalias.py
docs/modelo_ml_v1.json text eol=lf
docs/modelo_anomalias_v1.json text eol=lf
