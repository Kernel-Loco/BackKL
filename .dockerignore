.git
.env
.venv
**/__pycache__
.pytest_cache
.ruff_cache
pruebas
docs
db
*.md
# De datos/geo solo entran .gitkeep y las dos bases de DB-IP Lite (geoip.py): nada de .gz, City Lite ni otros archivos
datos/geo/*
!datos/geo/.gitkeep
!datos/geo/dbip-asn-lite-*.mmdb
!datos/geo/dbip-country-lite-*.mmdb

# Respaldos de la base (db/respaldo, RC-233)
respaldos
**/*.dump
**/*.dump.age

# Grabaciones de HIBP (RC-54): ligan correos del dominio a sus brechas, no entran en la imagen
cirdan/recolectores/respuestas_grabadas/hibp/*
!cirdan/recolectores/respuestas_grabadas/hibp/.gitkeep
